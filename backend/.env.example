# Login gate for the Emami Apps hub — copy this file to .env and fill in real values.
# .env is gitignored; never commit real credentials.
LOGIN_ALLOWED_EMAIL=
LOGIN_OTP=

# Comma-separated list of origins allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:8081,https://www.emamiapps.in

# Local dev only — Lambda ignores this (deploy-lambdas.js strips it before upload).
PORT=4000
