# EmamiApps hub Manage Access API — copy this file to .env and fill in real values.
# .env is gitignored; never commit real credentials.
# (Login itself lives in embedded-apps/mouldhealthcheck/backend/server.js now, not here.)

# Comma-separated list of origins allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:8081,https://www.emamiapps.in

# Local dev only — Lambda ignores this (deploy-lambdas.js strips it before upload).
PORT=4000

# Postgres (Development Environment DB) — backs the Manage Access screen's
# authorized-user/app-grant storage. Same instance as
# embedded-apps/mouldhealthcheck/backend/.env.
PGHOST=10.17.12.4
PGPORT=5432
PGDATABASE=Devhubfactory
PGUSER=Devhubuser
PGPASSWORD=
