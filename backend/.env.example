# Login gate for the Emami Apps hub — copy this file to .env and fill in real values.
# .env is gitignored; never commit real credentials.

# Microsoft Entra ID SAML SSO — see the setup steps in the comment block at the
# top of server.js. Also drop the metadata XML Infra gives you at
# backend/saml/idp-metadata.xml (gitignored, not committed).
LOGIN_ALLOWED_EMAIL_DOMAIN=emamigroup.com
# Any long random string — signs the short-lived session token issued after a
# real SSO login. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_JWT_SECRET=

# Comma-separated list of origins allowed to call this API (CORS). The FIRST
# one is also where the browser gets redirected back to after SSO login.
FRONTEND_ORIGIN=http://localhost:8081,https://www.emamiapps.in

# Local dev only — Lambda ignores this (deploy-lambdas.js strips it before upload).
PORT=4000

# Postgres (Development Environment DB) — backs the Manage Access screen's
# authorized-user/app-grant storage. Same instance as
# embedded-apps/mouldhealthcheck/backend/.env.
PGHOST=10.17.12.4
PGPORT=5432
PGDATABASE=Devhubfactory
PGUSER=Devhubuser
PGPASSWORD=
