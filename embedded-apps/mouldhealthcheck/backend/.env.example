# Postgres (Development Environment DB) — copy this file to .env and fill in real values.
# .env is gitignored; never commit real credentials.
PGHOST=10.17.12.4
PGPORT=5432
PGDATABASE=Devhubfactory
PGUSER=Devhubuser
PGPASSWORD=

# SAP OAuth client secret (existing, used by server.js)
CLIENT_SECRET=

# EmamiApps hub login (OAuth2/OIDC, reuses the SAP app registration's CLIENT_ID/CLIENT_SECRET
# above with a different scope) — see the "EMAMIAPPS HUB LOGIN" section in server.js.
HUB_AUTH_EMAIL_DOMAIN=emamigroup.com
# Any long random string — signs the short-lived session token issued after a real login.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUB_AUTH_JWT_SECRET=
# Where the browser gets redirected back to after login.
HUB_AUTH_FRONTEND_URL=https://www.emamiapps.in
