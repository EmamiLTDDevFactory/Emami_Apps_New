# Copy to .env for local dev. In Amplify, this is written into .env at build
# time from an Amplify Console environment variable (see amplify.yml).
#
# The hub-auth Lambda (backend/), fronted by API Gateway (see scripts/deploy-lambdas.js
# and backend/hub-auth.js) — serves both login (Microsoft OAuth2) and the Manage Access API.
EXPO_PUBLIC_AUTH_API_URL=http://localhost:4000/api
