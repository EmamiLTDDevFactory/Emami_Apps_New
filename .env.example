# Copy to .env for local dev. In Amplify, EXPO_PUBLIC_AUTH_API_URL is written into .env
# at build time from an Amplify Console environment variable (see amplify.yml) — it should
# point at the emami-apps-hub-auth Lambda Function URL (see scripts/deploy-lambdas.js).
EXPO_PUBLIC_AUTH_API_URL=http://localhost:4000/api
