# Copy to .env for local dev. In Amplify, both of these are written into .env
# at build time from Amplify Console environment variables (see amplify.yml).

# Login (Microsoft OAuth2) — the Azure App Service that hosts the EmamiApps hub
# login routes (see embedded-apps/mouldhealthcheck/backend/server.js,
# "EMAMIAPPS HUB LOGIN" section).
EXPO_PUBLIC_AUTH_API_URL=https://emdcindpwebapp1-bag2gfhjd9d4gkh6.centralindia-01.azurewebsites.net

# Manage Access API — the hub-auth Lambda Function URL (see scripts/deploy-lambdas.js
# and backend/server.js). A separate backend from login; don't merge these two vars.
EXPO_PUBLIC_ACCESS_API_URL=http://localhost:4000/api
